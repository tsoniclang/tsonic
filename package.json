{
  "name": "@tsonic/monorepo",
  "version": "0.0.1",
  "description": "Source-to-source compiler from TypeScript to target-native projects",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "./scripts/build/all.sh --no-format",
    "build:quick": "./scripts/build/all.sh --no-format",
    "clean": "./scripts/build/clean.sh",
    "clean:all": "./scripts/build/clean.sh --all",
    "test": "node scripts/test/run-parallel.mjs --with-preruns",
    "test:build": "bash scripts/test/build.sh",
    "test:parallel": "node scripts/test/run-parallel.mjs",
    "typecheck": "npm run build"
  },
  "workspaces": [
    "packages/tsts",
    "packages/source-core",
    "packages/target-api",
    "packages/host",
    "packages/cli"
  ],
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260617.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tsoniclang/tsonic.git"
  },
  "keywords": [
    "typescript",
    "source-to-source",
    "target-neutral",
    "compiler",
    "transpiler"
  ],
  "author": "Tsonic Project",
  "license": "MIT",
  "dependencies": {}
}
