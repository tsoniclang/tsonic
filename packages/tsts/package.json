{
  "name": "@tsonic/tsts",
  "version": "0.1.1",
  "description": "TypeScript-native TypeScript compiler targeting TS-Go contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsoniclang/tsonic.git",
    "directory": "packages/tsts"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./index.js": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./target-ast": {
      "types": "./dist/src/services/target-ast.d.ts",
      "import": "./dist/src/services/target-ast.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tsts": "./dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.js.map",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.d.ts.map"
  ]
}
