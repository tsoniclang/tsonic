{
  "name": "@tsonic/tsts",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript-native TypeScript compiler targeting TS-Go contracts",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./index.js": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "../../scripts/build/tsgo-project.sh ./tsconfig.json --pretty false"
  },
  "bin": {
    "tsts": "./dist/src/cli/index.js"
  },
  "files": [
    "src/**/*.ts",
    "tsonic.package.json",
    "tsonic.json",
    "README.md",
    "LICENSE"
  ]
}
