{
  "name": "@tsonic/target-api",
  "version": "0.1.1",
  "description": "Target pack contracts for the Tsonic source-to-source compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsoniclang/tsonic.git",
    "directory": "packages/target-api"
  },
  "type": "module",
  "main": "./dist/public/index.js",
  "types": "./dist/public/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts",
      "default": "./dist/public/index.js"
    },
    "./artifacts": {
      "types": "./dist/public/artifacts.d.ts",
      "default": "./dist/public/artifacts.js"
    },
    "./analysis": {
      "types": "./dist/public/analysis.d.ts",
      "default": "./dist/public/analysis.js"
    },
    "./provider": {
      "types": "./dist/public/provider.d.ts",
      "default": "./dist/public/provider.js"
    },
    "./source": {
      "types": "./dist/public/source.d.ts",
      "default": "./dist/public/source.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash ../../scripts/build/tsgo-project.sh ./tsconfig.json --pretty false",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@tsonic/tsts": "0.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
